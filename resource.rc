#include <windows.h>

#include "resource.h"
#include "build/generated/version.generated.h"

1 VERSIONINFO
FILEVERSION APP_VERSION_RESOURCE_TUPLE
PRODUCTVERSION APP_VERSION_RESOURCE_TUPLE
FILEFLAGSMASK 0x3fL
FILEFLAGS APP_VERSION_FILE_FLAGS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SIMP - Simple Image Manipulation Program"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "SIMP"
            VALUE "OriginalFilename", "simp.exe"
            VALUE "ProductName", "SIMP"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDR_BRANDING_VULKAN RCDATA "graphics/branding/vulkan.png"
IDR_BRANDING_LAKESHORE RCDATA "graphics/branding/lakeshore.png"

IDD_ABOUT_DIALOG DIALOGEX 0, 0, 228, 96
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SIMP"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "SIMP", IDC_ABOUT_TEXT, 14, 14, 198, 34
    DEFPUSHBUTTON "OK", IDOK, 88, 68, 52, 14
END

#include "build/generated/splash_frames.rcinc"
IDD_GRID_SETTINGS DIALOGEX 0, 0, 260, 142
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Grid Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Cell spacing:", -1, 12, 16, 90, 12
    EDITTEXT IDC_SETTING_VALUE, 106, 14, 66, 14, ES_AUTOHSCROLL
    COMBOBOX IDC_SETTING_UNITS, 178, 14, 70, 65, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Major line every:", -1, 12, 43, 90, 12
    EDITTEXT IDC_SETTING_MAJOR, 106, 41, 66, 14, ES_AUTOHSCROLL
    LTEXT "cells (0 = off)", -1, 178, 44, 70, 12
    AUTOCHECKBOX "Show grid", IDC_SETTING_VISIBLE, 12, 68, 120, 14
    LTEXT "Spacing also sets the size of the cell paint tool.", -1, 12, 90, 236, 12
    DEFPUSHBUTTON "OK", IDOK, 136, 116, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 196, 116, 52, 14
END

IDD_RULER_SETTINGS DIALOGEX 0, 0, 236, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ruler Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Units:", -1, 12, 17, 70, 12
    COMBOBOX IDC_SETTING_UNITS, 90, 14, 134, 65, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Show rulers", IDC_SETTING_VISIBLE, 12, 43, 180, 14
    DEFPUSHBUTTON "OK", IDOK, 112, 74, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 172, 74, 52, 14
END

IDD_IMAGE_SETTINGS DIALOGEX 0, 0, 270, 154
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Image Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Pixels per inch:", -1, 12, 17, 110, 12
    EDITTEXT IDC_SETTING_VALUE, 140, 14, 118, 14, ES_AUTOHSCROLL
    LTEXT "", IDC_SETTING_INFO, 12, 43, 246, 28
    LTEXT "Changing PPI changes physical measurements. Pixel dimensions and image detail stay the same.", -1, 12, 82, 246, 28
    DEFPUSHBUTTON "OK", IDOK, 146, 128, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 206, 128, 52, 14
END

IDD_NEW_CANVAS DIALOGEX 0, 0, 250, 145
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Canvas"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Width (pixels):", -1, 12, 17, 110, 12
    EDITTEXT IDC_SETTING_WIDTH, 138, 14, 100, 14, ES_AUTOHSCROLL
    LTEXT "Height (pixels):", -1, 12, 44, 110, 12
    EDITTEXT IDC_SETTING_HEIGHT, 138, 41, 100, 14, ES_AUTOHSCROLL
    LTEXT "Pixels per inch:", -1, 12, 71, 110, 12
    EDITTEXT IDC_SETTING_VALUE, 138, 68, 100, 14, ES_AUTOHSCROLL
    LTEXT "Up to 64 million pixels; 16,384 pixels per side.", -1, 12, 94, 226, 12
    DEFPUSHBUTTON "Create", IDOK, 126, 119, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 186, 119, 52, 14
END

IDD_LINE_SETTINGS DIALOGEX 0, 0, 228, 118
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Line Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Thickness (image pixels):", -1, 12, 16, 142, 12
    EDITTEXT IDC_SETTING_VALUE, 162, 14, 54, 14, ES_AUTOHSCROLL
    LTEXT "Color:", -1, 12, 45, 54, 12
    PUSHBUTTON "Choose...", IDC_LINE_COLOR, 76, 41, 140, 18
    PUSHBUTTON "Delete", IDC_LINE_DELETE, 12, 90, 52, 14
    DEFPUSHBUTTON "OK", IDOK, 104, 90, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 164, 90, 52, 14
END

IDD_PNG_EXPORT DIALOGEX 0, 0, 340, 174
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Export to PNG"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Save PNG to:", -1, 12, 12, 306, 12
    EDITTEXT IDC_EXPORT_PATH, 12, 28, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_EXPORT_BROWSE, 270, 28, 58, 14
    LTEXT "Lossless filtering:", -1, 12, 60, 102, 12
    COMBOBOX IDC_EXPORT_FILTER, 118, 57, 210, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Interlaced (progressive display)", IDC_EXPORT_INTERLACE, 12, 86, 300, 14
    LTEXT "8-bit RGBA, including transparency and image PPI. Both filter modes preserve every pixel. Rulers, grid and lines are not exported.", -1, 12, 110, 316, 27
    DEFPUSHBUTTON "Export", IDOK, 216, 148, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 276, 148, 52, 14
END

IDD_CEL_NAME DIALOGEX 0, 0, 250, 78
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Name Cel"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Cel name:", -1, 12, 12, 220, 12
    EDITTEXT IDC_CEL_NAME, 12, 28, 226, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 126, 54, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 186, 54, 52, 14
END
