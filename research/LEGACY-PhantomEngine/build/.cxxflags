CLANG_FLAGS=--target=x86_64-pc-windows-msvc -fuse-ld=lld-link -DUNICODE -D_UNICODE -DNOMINMAX /std:c++latest /EHsc /MT -fexceptions -fcxx-exceptions -fopenmp -msse2 -msse3 -mssse3 -msse4.1 -msse4.2 -D__SSE2__ -D__SSSE3__ -fms-compatibility -fms-compatibility-version=19.37 -D_MT -Wall -Wextra -Wpedantic -Wshadow -Wnon-virtual-dtor -Wunused -Woverloaded-virtual -Wno-unknown-argument -Wno-unused-command-line-argument -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-nonportable-system-include-path -Wno-unsafe-buffer-usage -Wno-padded -Wno-sign-conversion -Wno-newline-eof -Wno-implicit-int-float-conversion -Wno-zero-as-null-pointer-constant -Wno-exit-time-destructors -Wno-global-constructors -Wno-old-style-cast -Wno-missing-prototypes -Wno-missing-variable-declarations -Wno-documentation -Wno-documentation-unknown-command -Wno-language-extension-token -Wno-ctad-maybe-unsupported -Wno-reserved-identifier -Wno-float-equal -Wno-comma -Wno-cast-function-type-strict -Wno-source-uses-openmp -Wno-switch-default -Wno-switch-enum -Wno-unreachable-code-return -Wno-missing-braces -Wno-macro-redefined -Wno-missing-field-initializers -Wno-shadow-uncaptured-local -Wno-format -Wno-nrvo -Wno-missing-designated-field-initializers -Wno-covered-switch-default -Wno-disabled-macro-expansion -Wno-double-promotion -Wno-cast-qual -Wno-extra-semi-stmt -Wno-implicit-fallthrough -Wno-implicit-int-conversion -Wno-cast-align -imsvc/opt/msvc/include -imsvc/opt/winsdk/crt/include -imsvc/opt/winsdk/sdk/include/10.0.26100/ucrt -imsvc/opt/winsdk/sdk/include/10.0.26100/um -imsvc/opt/winsdk/sdk/include/10.0.26100/shared -imsvc/opt/winsdk/sdk/include/10.0.26100/winrt -imsvc/opt/winsdk/sdk/include/cppwinrt -I/opt/repos/Phantom-Engine/Legacy/Engine/include -I/opt/windows-libs/zlib/include -I/opt/windows-libs/zstd/include -I/opt/windows-libs/ADLMIDI/include -I/opt/windows-libs/libpng/include -I/opt/VulkanSDK/1.4.313.2/Include -O3 -DNDEBUG -fno-rtti -march=native -mtune=native -flto=thin
INCLUDE=/opt/winsdk/crt/include;/opt/winsdk/sdk/include/10.0.26100/um;/opt/winsdk/sdk/include/10.0.26100/shared;/opt/winsdk/sdk/include/10.0.26100/ucrt;
LIB=/opt/winsdk/crt/lib/x86_64;/opt/winsdk/sdk/lib/um/x86_64;/opt/winsdk/sdk/lib/ucrt/x86_64;