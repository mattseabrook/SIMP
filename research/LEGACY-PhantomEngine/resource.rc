#include <windows.h>
#include "resource.h"

IDB_SYSINFO_BG RCDATA "SystemInformation.bmp"
IDB_CHESS_PNG RCDATA "chess.png"
IDR_MENU_TITLE_TTF RCDATA "vtc-night-of-the.dead-corruptcaps.ttf"

IDI_ICON1 ICON "icon.ico"

IDD_ABOUT_DIALOG DIALOGEX 0, 0, 200, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Phantom Engine"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_ABOUT_ICON, "STATIC", SS_ICON | WS_CHILD | WS_VISIBLE, 90, 10, 64, 64
    LTEXT           "Phantom Engine - v0.1 (c) Matthew Seabrook.", IDC_STATIC, 10, 40, 180, 60
    DEFPUSHBUTTON   "OK", IDOK, 75, 150, 50, 14
END
